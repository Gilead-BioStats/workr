Package: workr
Type: Package
Title: Workflow Execution Helpers
Version: 0.1.0
Author: Workr Maintainer [aut, cre], Gilead Biostats [cph]
Maintainer: Workr Maintainer <maintainer@workr.example>
Authors@R: c(
    person("Workr", "Maintainer", email = "maintainer@workr.example", role = c("aut", "cre")),
    person("Gilead", "Biostats", role = "cph")
